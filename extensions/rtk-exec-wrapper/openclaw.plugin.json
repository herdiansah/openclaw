{
  "id": "rtk-exec-wrapper",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "rtkPath": {
        "type": "string",
        "default": "~/.local/bin/rtk"
      },
      "commands": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["git", "cargo test", "npm test", "docker ps", "kubectl"]
      },
      "timeout": {
        "type": "number",
        "default": 30000
      }
    }
  }
}
